{
  "name": "free-local-agent-desktop",
  "version": "0.5.0-alpha.1",
  "private": true,
  "description": "Free Local Agent — your local AI agent, with bundled inference and hardware-aware models",
  "author": "Local Agent contributors",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test local-agent/desktop/tests/*.test.ts local-agent/runtime/tests/*.test.ts",
    "prepare:backend": "node scripts/prepare-backend.mjs",
    "prepare:research": "node scripts/prepare-research.mjs",
    "package": "npm run build && electron-builder --publish never",
    "check": "npm run typecheck && npm test",
    "smoke:package": "node scripts/smoke-packaged.mjs",
    "prepare:inference": "node scripts/prepare-inference.mjs",
    "prepare:ssd": "node scripts/prepare-ssd-inference.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "electron": "43.7.8",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "org.localagent.desktop",
    "productName": "Free Local Agent",
    "artifactName": "Free-Local-Agent-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE",
      "NOTICE"
    ],
    "extraResources": [
      {
        "from": "assets/branding/free-local-agent.png",
        "to": "free-local-agent.png"
      },
      {
        "from": "resources/goose",
        "to": "goose"
      },
      {
        "from": "resources/inference",
        "to": "inference"
      },
      {
        "from": "local-agent/research/dist/local-agent-research",
        "to": "research"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "extraResources": [{ "from": "resources/ssd-inference/darwin-arm64", "to": "ssd-inference/darwin-arm64" }],
      "icon": "assets/branding/free-local-agent.icns",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.3"
    },
    "win": {
      "icon": "assets/branding/free-local-agent.ico",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/branding/free-local-agent.png",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "Local Agent contributors"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgomp1",
        "libvulkan1",
        "libstdc++6 (>= 12)",
        "libc6 (>= 2.34)"
      ]
    }
  }
}
