+++ b/ggml/src/ggml-ssd-policy.cpp
@@ -0,0 +1,200 @@
+#include "ggml-ssd-policy.h"
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <ctime>
+#include <mutex>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#if defined(__APPLE__)
+#include <libproc.h>
+#include <sys/resource.h>
+#include <unistd.h>
+#endif
+#ifndef SSD_PATCH_SHA256
+#define SSD_PATCH_SHA256 "development"
+#endif
+static constexpr uint64_t MAX_DEADLINE_MS = 8ull*60*60*1000;
+static constexpr uint64_t OVERHEAD_RESERVE = 256ull*1024*1024;
+struct ssd_policy {
+    std::mutex mtx;
+    std::condition_variable cv;
+    std::array<uint64_t, GGML_SSD_KINDS> ledger{};
+    uint64_t total = 0, budget = 0, limit = 0, cache_budget = 0;
+    uint32_t expected = 0, streamed = 0, slots = 0;
+    int use_extra_bufts = -1;
+    uint32_t cpu_repack_tensor_count = 0;
+    uint32_t decode_threads = 0, batch_threads = 0;
+    uint64_t reads = 0, hits = 0, waves = 0, bytes_read = 0, cache_misses = 0;
+    uint64_t rss = 0, footprint = 0;
+    bool measurement = false, io = false, enabled = false, done = false, deadline_armed = true;
+    std::atomic<bool> stopped{false};
+    std::string reason, stage = "boot", sampled_at;
+    std::chrono::steady_clock::time_point deadline;
+    std::thread sampler;
+    ~ssd_policy() { ggml_ssd_finish(); }
+};
+static ssd_policy policy;
+static thread_local int category = GGML_SSD_SCRATCH;
+static void measure_locked() {
+#if defined(__APPLE__)
+    rusage_info_v4 usage{};
+    if (proc_pid_rusage(getpid(), RUSAGE_INFO_V4, (rusage_info_t*)&usage) == 0) {
+        policy.rss = usage.ri_resident_size;
+        policy.footprint = usage.ri_phys_footprint;
+        policy.measurement = policy.footprint > 0 && policy.rss > 0;
+    } else { policy.measurement = false; }
+#else
+    policy.measurement = false;
+#endif
+    const auto now = std::chrono::system_clock::now();
+    const auto t = std::chrono::system_clock::to_time_t(now);
+    std::tm utc{}; gmtime_r(&t,&utc);
+    char s[40]; strftime(s,sizeof(s),"%Y-%m-%dT%H:%M:%SZ",&utc); policy.sampled_at=s;
+}
+static std::string snapshot_locked() {
+    const char * names[] = {"denseBytes","expertCacheBytes","stagingBytes","contextBytes",
+                           "recurrentBytes","scratchBytes","uploadBytes","reservedBytes"};
+    std::ostringstream s;
+    s << "{\"workerIdentity\":\"free-local-agent-ssd-v1\",\"patchSha256\":\"" << SSD_PATCH_SHA256
+      << "\",\"baseCommit\":\"d81235049384534c167caea52b85a694f6103d14\",\"pid\":";
+#if defined(__APPLE__)
+    s << getpid();
+#else
+    s << 0;
+#endif
+    s << ",\"stage\":\"" << policy.stage << "\",\"sampledAt\":\"" << policy.sampled_at
+      << "\",\"expectedGroups\":" << policy.expected << ",\"streamedGroups\":" << policy.streamed
+      << ",\"cacheSlotsPerLayer\":" << policy.slots
+      << ",\"ioMode\":\"" << (policy.io ? "darwin-nocache" : "unvalidated")
+      << "\",\"allocationBudgetBytes\":" << policy.budget << ",\"residentLimitBytes\":" << policy.limit
+      << ",\"cpuKernel\":\"" << (policy.use_extra_bufts<0?"unknown":policy.use_extra_bufts?"default":"standard") << "\",\"useExtraBufts\":";
+    if(policy.use_extra_bufts<0) s << "null"; else s << (policy.use_extra_bufts?"true":"false");
+    s << ",\"cpuRepackTensorCount\":";
+    if(policy.use_extra_bufts<0) s << "null"; else s << policy.cpu_repack_tensor_count;
+    s << ",\"decodeThreads\":";
+    if(!policy.decode_threads) s << "null"; else s << policy.decode_threads;
+    s << ",\"batchThreads\":";
+    if(!policy.batch_threads) s << "null"; else s << policy.batch_threads;
+    s << ",\"expertCacheBytes\":" << policy.ledger[GGML_SSD_CACHE] << ",\"ledger\":{";
+    for (int i=0;i<GGML_SSD_KINDS;i++) { if(i) s << ','; s << '"' << names[i] << "\":" << policy.ledger[i]; }
+    s << ",\"totalBytes\":" << policy.total << "},\"rssBytes\":";
+    if (policy.measurement) s << policy.rss; else s << "null";
+    s << ",\"physicalFootprintBytes\":";
+    if (policy.measurement) s << policy.footprint; else s << "null";
+    s << ",\"reads\":" << policy.reads << ",\"hits\":" << policy.hits << ",\"waves\":" << policy.waves
+      << ",\"bytesRead\":" << policy.bytes_read << ",\"cacheMisses\":" << policy.cache_misses
+      << ",\"deadlineArmed\":" << (policy.deadline_armed?"true":"false")
+      << ",\"stopped\":" << (policy.stopped.load()?"true":"false")
+      << ",\"stopReason\":\"" << policy.reason << "\"}";
+    return s.str();
+}
+static void emit_locked() { fprintf(stderr,"SSD_STATUS %s\n",snapshot_locked().c_str()); fflush(stderr); }
+void ggml_ssd_start(uint64_t budget,uint64_t limit,uint64_t deadline_ms) {
+    if (!budget || !limit || budget>limit || budget<OVERHEAD_RESERVE || !deadline_ms || deadline_ms>MAX_DEADLINE_MS)
+        throw std::invalid_argument("invalid SSD allocation/resident budget or deadline");
+#if !defined(__APPLE__)
+    throw std::runtime_error("SSD worker only validated on Darwin ARM64");
+#endif
+    std::lock_guard<std::mutex> lock(policy.mtx);
+    if(policy.enabled) throw std::runtime_error("SSD worker already initialized");
+    policy.enabled=true; policy.done=false; policy.stopped=false;
+    policy.budget=budget; policy.limit=limit; policy.deadline=std::chrono::steady_clock::now()+std::chrono::milliseconds(deadline_ms);
+    policy.ledger[GGML_SSD_RESERVED]=OVERHEAD_RESERVE; policy.total=OVERHEAD_RESERVE;
+    measure_locked(); emit_locked();
+    if(!policy.measurement) throw std::runtime_error("native physical footprint monitoring unavailable");
+    policy.sampler=std::thread([]{
+        std::unique_lock<std::mutex> lock(policy.mtx);
+        auto next_sample=std::chrono::steady_clock::now();
+        while(!policy.done) {
+            policy.cv.wait_for(lock,std::chrono::milliseconds(100),[]{return policy.done;});
+            if(policy.done) break;
+            auto now=std::chrono::steady_clock::now();
+            if(now>=next_sample) {
+                measure_locked(); emit_locked(); next_sample=now+std::chrono::seconds(2);
+                if(!policy.measurement) { policy.reason="native-memory-monitor-unavailable"; policy.stopped=true; }
+                else if(policy.footprint>policy.limit || policy.rss>policy.limit) { policy.reason="resident-memory-budget"; policy.stopped=true; }
+            }
+            if(policy.deadline_armed && now>=policy.deadline) { policy.reason="deadline"; policy.stopped=true; }
+            // Process termination bounds otherwise uninterruptible filesystem and driver calls.
+            if(policy.stopped) { policy.stage="stopped"; emit_locked(); std::_Exit(75); }
+        }
+    });
+}
+void ggml_ssd_cache_budget(uint64_t bytes) { std::lock_guard<std::mutex> lock(policy.mtx); policy.cache_budget=bytes; }
+void ggml_ssd_cpu_kernel(bool use_extra_bufts,uint32_t repack_tensor_count) {
+    if(!use_extra_bufts && repack_tensor_count) throw std::runtime_error("standard CPU profile must not use CPU_REPACK tensors");
+    std::lock_guard<std::mutex> lock(policy.mtx);
+    policy.use_extra_bufts=use_extra_bufts; policy.cpu_repack_tensor_count=repack_tensor_count;
+}
+void ggml_ssd_cpu_threads(uint32_t decode_threads,uint32_t batch_threads) {
+    if(!decode_threads || !batch_threads || decode_threads>64 || batch_threads>64)
+        throw std::runtime_error("SSD CPU threads must fit the planned 1-to-64 thread bound");
+    std::lock_guard<std::mutex> lock(policy.mtx);
+    policy.decode_threads=decode_threads; policy.batch_threads=batch_threads;
+}
+void ggml_ssd_finish() {
+    { std::lock_guard<std::mutex> lock(policy.mtx); policy.done=true; policy.cv.notify_all(); }
+    if(policy.sampler.joinable()) policy.sampler.join();
+}
+bool ggml_ssd_enabled() { return policy.enabled; }
+bool ggml_ssd_stopped() { return policy.stopped.load(); }
+void ggml_ssd_cancel(const char * reason) {
+    std::lock_guard<std::mutex> lock(policy.mtx);
+    policy.reason = reason && std::string(reason)=="deadline" ? "deadline" : "cancelled";
+    policy.stopped=true; policy.cv.notify_all();
+}
+bool ggml_ssd_deadline(uint64_t ms) {
+    if(!ms || ms>MAX_DEADLINE_MS || policy.stopped) return false;
+    std::lock_guard<std::mutex> lock(policy.mtx); policy.deadline=std::chrono::steady_clock::now()+std::chrono::milliseconds(ms); policy.deadline_armed=true;
+    return true;
+}
+void ggml_ssd_shutdown() {
+    std::lock_guard<std::mutex> lock(policy.mtx);
+    auto bound=std::chrono::steady_clock::now()+std::chrono::seconds(10);
+    if(!policy.deadline_armed || bound<policy.deadline) policy.deadline=bound;
+    policy.deadline_armed=true; policy.stage="shutting-down";
+}
+void ggml_ssd_idle() { std::lock_guard<std::mutex> lock(policy.mtx); if(!policy.stopped) policy.deadline_armed=false; }
+bool ggml_ssd_deadline_armed() { std::lock_guard<std::mutex> lock(policy.mtx); return policy.deadline_armed && !policy.stopped; }
+bool ggml_ssd_reserve(size_t n,int kind) {
+    if(!policy.enabled || n==0) return true;
+    std::lock_guard<std::mutex> lock(policy.mtx);
+    if(kind<0 || kind>=GGML_SSD_KINDS || policy.stopped || n>policy.budget-policy.total) return false;
+    if(kind==GGML_SSD_CACHE && policy.cache_budget && n>policy.cache_budget-policy.ledger[kind]) return false;
+    policy.total+=n; policy.ledger[kind]+=n; return true;
+}
+void ggml_ssd_release(size_t n,int kind) {
+    if(!policy.enabled || n==0) return;
+    std::lock_guard<std::mutex> lock(policy.mtx);
+    if(kind>=0 && kind<GGML_SSD_KINDS && policy.ledger[kind]>=n) { policy.ledger[kind]-=n; policy.total-=n; }
+}
+int ggml_ssd_category(int kind) { int old=category; category=kind; return old; }
+int ggml_ssd_current_category() { return category; }
+const char * ggml_ssd_snapshot() {
+    static thread_local std::string json;
+    std::lock_guard<std::mutex> lock(policy.mtx); json=snapshot_locked(); return json.c_str();
+}
+void ggml_ssd_stage(const char * stage) { std::lock_guard<std::mutex> lock(policy.mtx); policy.stage=stage; if(policy.stage=="ready") policy.deadline_armed=false; }
+void ggml_ssd_groups(uint32_t expected,uint32_t streamed,uint32_t slots) {
+    std::lock_guard<std::mutex> lock(policy.mtx); policy.expected=expected; policy.streamed=streamed; policy.slots=slots;
+}
+void ggml_ssd_io_validated() { std::lock_guard<std::mutex> lock(policy.mtx); policy.io=true; }
+void ggml_ssd_progress(int kind,uint64_t n) {
+    std::lock_guard<std::mutex> lock(policy.mtx); if(kind==0)policy.reads+=n; else if(kind==1)policy.hits+=n; else if(kind==2) policy.waves+=n; else if(kind==3) policy.bytes_read+=n; else if(kind==4) policy.cache_misses+=n;
+}
+uint32_t ggml_ssd_slots(uint32_t experts,uint32_t top_k,uint64_t bytes,uint64_t budget,uint32_t requested) {
+    if(!experts || !top_k || top_k>UINT32_MAX/3 || !bytes || 3*top_k>=experts)
+        throw std::runtime_error("model cannot use bounded SSD expert streaming");
+    const uint32_t floor=3*top_k;
+    if(budget && (budget/bytes<floor)) throw std::runtime_error("SSD cache budget is below three times topK; refusing full-weight fallback");
+    uint64_t slots=requested ? requested : budget ? budget/bytes : floor;
+    if(slots<floor || slots>=experts || slots>UINT32_MAX || (budget && slots>budget/bytes))
+        throw std::runtime_error("SSD slots violate cache budget or three-times-topK floor");
+    return uint32_t(slots);
+}
