+#include <stdint.h>
+#include <stddef.h>
+#ifdef __cplusplus
+#include <new>
+#endif
+#ifdef __cplusplus
+extern "C" {
+#endif
+enum ggml_ssd_kind { GGML_SSD_DENSE, GGML_SSD_CACHE, GGML_SSD_STAGING, GGML_SSD_CONTEXT,
+                     GGML_SSD_RECURRENT, GGML_SSD_SCRATCH, GGML_SSD_UPLOAD, GGML_SSD_RESERVED, GGML_SSD_KINDS };
+GGML_API void ggml_ssd_start(uint64_t budget, uint64_t resident_limit, uint64_t deadline_ms);
+GGML_API void ggml_ssd_finish(void);
+GGML_API void ggml_ssd_cache_budget(uint64_t bytes);
+GGML_API bool ggml_ssd_enabled(void);
+GGML_API bool ggml_ssd_stopped(void);
+GGML_API void ggml_ssd_cancel(const char * reason);
+GGML_API bool ggml_ssd_deadline(uint64_t duration_ms);
+GGML_API void ggml_ssd_idle(void);
+GGML_API void ggml_ssd_shutdown(void);
+GGML_API bool ggml_ssd_deadline_armed(void);
+GGML_API bool ggml_ssd_reserve(size_t size, int kind);
+GGML_API void ggml_ssd_release(size_t size, int kind);
+GGML_API int ggml_ssd_category(int kind);
+GGML_API int ggml_ssd_current_category(void);
+GGML_API const char * ggml_ssd_snapshot(void);
+GGML_API void ggml_ssd_stage(const char * stage);
+GGML_API void ggml_ssd_groups(uint32_t expected, uint32_t streamed, uint32_t slots);
+GGML_API void ggml_ssd_cpu_kernel(bool use_extra_bufts, uint32_t repack_tensor_count);
+GGML_API void ggml_ssd_cpu_threads(uint32_t decode_threads, uint32_t batch_threads);
+GGML_API void ggml_ssd_io_validated(void);
+GGML_API void ggml_ssd_progress(int kind, uint64_t count);
+GGML_API uint32_t ggml_ssd_slots(uint32_t experts, uint32_t top_k, uint64_t expert_bytes,
+                                  uint64_t cache_budget, uint32_t requested_slots);
+#ifdef __cplusplus
+}
+struct ggml_ssd_scope {
+    int previous;
+    explicit ggml_ssd_scope(int kind) : previous(ggml_ssd_category(kind)) {}
+    ~ggml_ssd_scope() { ggml_ssd_category(previous); }
+};
+struct ggml_ssd_bytes {
+    size_t size;
+    int kind;
+    ggml_ssd_bytes(size_t n, int k) : size(n), kind(k) {
+        if (!ggml_ssd_reserve(n,k)) throw std::bad_alloc();
+    }
+    ~ggml_ssd_bytes() { ggml_ssd_release(size,kind); }
+};
+#endif
