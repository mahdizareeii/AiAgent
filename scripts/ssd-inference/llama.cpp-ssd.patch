diff --git a/tests/test-ssd-native.cpp b/tests/test-ssd-native.cpp
new file mode 100644
index 000000000..43fb64f38
--- /dev/null
+++ b/tests/test-ssd-native.cpp
@@ -0,0 +1,238 @@
+#include "llama-moe-stream.h"
+#include "llama-model.h"
+#include "llama-memory-recurrent.h"
+#include "ggml-backend.h"
+#include "ggml-cpu.h"
+#include "ggml-ssd-policy.h"
+#include <cmath>
+#include <array>
+#include <cstdio>
+#include <cstring>
+#include <cstdlib>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+#include <unistd.h>
+#include <chrono>
+#include <thread>
+static int checks=0;
+static void check(bool pass,const char * label) { if(!pass) throw std::runtime_error(label); checks++; }
+static void floors() {
+    check(ggml_ssd_slots(128,8,100,2400,0)==24,"Gemma floor");
+    check(ggml_ssd_slots(512,10,100,3000,0)==30,"Qwen floor");
+    for(auto args: {std::array<uint64_t,5>{128,8,100,2399,0}, {512,10,100,2999,0},
+                   {128,8,100,2400,23}, {128,8,100,2400,25}, {128,8,100,12800,128},
+                   {0,8,100,2400,0}, {128,0,100,2400,0}}) {
+        bool rejected=false;
+        try { ggml_ssd_slots(args[0],args[1],args[2],args[3],args[4]); }
+        catch(const std::exception &) { rejected=true; }
+        check(rejected,"invalid cache floor rejected");
+    }
+}
+static void cache_test(bool use_metal) {
+    char temp[]="/tmp/free-local-ssd-test-XXXXXX";
+    int fd=mkstemp(temp); if(fd<0) throw std::runtime_error("fixture create failed");
+    close(fd);
+    auto * ctx=ggml_init({1024*1024,nullptr,false});
+    check(ctx!=nullptr,"synthetic context");
+    auto * cpu=ggml_backend_cpu_buffer_type();
+    ggml_backend_t metal=nullptr;
+    if(use_metal) {
+        auto * dev=ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
+        if(!dev) throw std::runtime_error("no native Metal device");
+        metal=ggml_backend_dev_init(dev,nullptr); if(!metal) throw std::runtime_error("Metal device unavailable"); cpu=ggml_backend_dev_buffer_type(dev);
+    }
+    {
+        llama_moe_stream mgr(1,6,2,false);
+        std::ofstream file(temp,std::ios::binary);
+        const char * names[]={"blk.0.ffn_gate_exps.weight","blk.0.ffn_up_exps.weight","blk.0.ffn_down_exps.weight"};
+        std::vector<ggml_tensor *> original_weights;
+        size_t offset=0;
+        for(int w=0;w<3;w++) {
+            auto * meta=ggml_new_tensor_3d(ctx,GGML_TYPE_F32,32,4,12);
+            ggml_set_name(meta,names[w]); original_weights.push_back(meta);
+            auto * data=(float *)meta->data;
+            for(int e=0;e<12;e++) for(int j=0;j<128;j++) data[e*128+j]=float(w*1000+e*10+j)/100;
+            file.write((char *)data,ggml_nbytes(meta));
+            mgr.create_cache_tensor(0,cpu,meta,0,offset); offset+=ggml_nbytes(meta);
+        }
+        file.close(); mgr.alloc_bufs(false); mgr.open_files({temp});
+        check(mgr.n_io_threads==2,"bounded two I/O workers");
+        auto * sl=mgr.layer(0);
+        auto * ids=ggml_new_tensor_2d(ctx,GGML_TYPE_I32,2,1);
+        auto * slots=ggml_dup_tensor(ctx,ids);
+        auto * iv=(int32_t *)ids->data;
+        auto verify=[&](ggml_tensor * out,ggml_tensor * original,ggml_tensor * mask=nullptr) {
+            for(int i=0;i<ggml_nelements(out);i++) {
+                if(mask && ((float *)mask->data)[i]==0) continue;
+                int slot=((int32_t *)out->data)[i], expert=((int32_t *)original->data)[i];
+                for(int w=0;w<3;w++) {
+                    alignas(4096) float slab[128];
+                    ggml_backend_tensor_get(sl->weights[w].cache,slab,slot*512,512);
+                    for(int j=0;j<128;j++) check(slab[j]==float(w*1000+expert*10+j)/100,"exact raw expert bytes after slot remap");
+                }
+            }
+        };
+        iv[0]=0; iv[1]=1;
+        llama_moe_stream_remap(slots,ids,0,1,sl); verify(slots,ids);
+        auto misses=mgr.stats.n_miss;
+        llama_moe_stream_remap(slots,ids,0,1,sl); verify(slots,ids);
+        check(mgr.stats.n_miss==misses,"resident cache hit has no duplicate read");
+        for(int e=2;e<12;e+=2) { iv[0]=e;iv[1]=e+1;llama_moe_stream_remap(slots,ids,0,1,sl);verify(slots,ids); }
+        check(sl->expert_slot.size()<=6,"eviction remains bounded");
+        check(sl->expert_slot.count(2)==0,"cold expert evicted while hot experts survive");
+        auto * many=ggml_new_tensor_2d(ctx,GGML_TYPE_I32,2,4);
+        auto * wave_slots=ggml_dup_tensor(ctx,many); wave_slots->src[0]=many;
+        auto * mask=ggml_new_tensor_2d(ctx,GGML_TYPE_F32,2,4);mask->src[0]=many;
+        for(int i=0;i<8;i++) ((int32_t *)many->data)[i]=i;
+        float counts[8]{};
+        ggml_backend_t compute=use_metal ? nullptr : ggml_backend_cpu_init();
+        auto * input=ggml_new_tensor_3d(ctx,GGML_TYPE_F32,32,2,4);
+        for(int i=0;i<256;i++) ((float *)input->data)[i]=float(i%13-6)/17;
+        auto * baseline=ggml_mul_mat_id(ctx,original_weights[0],input,many);
+        auto * streamed=ggml_mul_mat_id(ctx,sl->weights[0].cache,input,wave_slots);
+        float summed[32]{};
+        if(compute) {
+            auto * graph=ggml_new_graph(ctx);ggml_build_forward_expand(graph,baseline);
+            check(ggml_backend_graph_compute(compute,graph)==GGML_STATUS_SUCCESS,"ordinary expert graph computes");
+        }
+        // Four waves of capacity two preserve the selected expert set with a six-slot cache.
+        for(int w=0;w<4;w++) {
+            auto * ud=sl->wave_userdata(w,2);
+            llama_moe_stream_wave_ids(wave_slots,0,1,ud);
+            llama_moe_stream_wave_mask(mask,0,1,ud);
+            verify(wave_slots,many,mask);
+            if(compute) {
+                auto * graph=ggml_new_graph(ctx);ggml_build_forward_expand(graph,streamed);
+                check(ggml_backend_graph_compute(compute,graph)==GGML_STATUS_SUCCESS,"streamed expert graph computes");
+                for(int i=0;i<32;i++) summed[i]+=((float *)streamed->data)[i]*((float *)mask->data)[i/4];
+            }
+            for(int i=0;i<8;i++) counts[i]+=((float *)mask->data)[i];
+        }
+        if(compute) {
+            for(int i=0;i<32;i++) check(std::fabs(summed[i]-((float *)baseline->data)[i])<1e-5,"waved real matmul numerically matches ordinary experts");
+            ggml_backend_free(compute);
+        }
+        for(auto count:counts) check(count==1,"each routed pair contributes exactly once across waves");
+        check(sl->expert_slot.size()<=6,"waved prefill cache remains bounded");
+        check(mgr.workers.size()==2,"no extra workers spawned");
+    }
+    if(metal) ggml_backend_free(metal);
+    ggml_free(ctx); unlink(temp);
+}
+static void ledger_test() {
+    ggml_ssd_start(512ull*1024*1024,4ull*1024*1024*1024,5000);
+    auto before=std::string(ggml_ssd_snapshot());
+    check(before.find("physicalFootprintBytes\":null")==std::string::npos,"native footprint measured at boot");
+    check(before.find("cpuKernel\":\"unknown\"")!=std::string::npos,"kernel is unknown before model buffers are assigned");
+    ggml_ssd_cpu_kernel(false,0);
+    ggml_ssd_cpu_threads(4,4);
+    check(std::string(ggml_ssd_snapshot()).find("decodeThreads\":4")!=std::string::npos &&
+          std::string(ggml_ssd_snapshot()).find("batchThreads\":4")!=std::string::npos,"actual context thread counts are reported");
+    bool rejected=false;try { ggml_ssd_cpu_threads(65,4); }catch(const std::runtime_error &) { rejected=true; }
+    check(rejected,"thread count beyond planned workspace bound rejected");
+    auto standard=std::string(ggml_ssd_snapshot());
+    check(standard.find("cpuKernel\":\"standard\"")!=std::string::npos && standard.find("useExtraBufts\":false")!=std::string::npos &&
+          standard.find("cpuRepackTensorCount\":0")!=std::string::npos,"standard CPU proof reports actual no-repack configuration");
+    rejected=false;try { ggml_ssd_cpu_kernel(false,1); }catch(const std::runtime_error &) { rejected=true; }
+    check(rejected,"no-repack request rejects repacked model tensors");
+    check(std::string(ggml_ssd_snapshot()).find("cpuRepackTensorCount\":0")!=std::string::npos,"rejected kernel proof does not replace settled configuration");
+    ggml_ssd_cpu_kernel(true,3);
+    check(std::string(ggml_ssd_snapshot()).find("cpuKernel\":\"default\"")!=std::string::npos &&
+          std::string(ggml_ssd_snapshot()).find("cpuRepackTensorCount\":3")!=std::string::npos,"default kernel reports observed repack tensors without claiming standard equivalence");
+    ggml_ssd_cpu_kernel(false,0);
+    check(!ggml_ssd_reserve(SIZE_MAX,GGML_SSD_CACHE),"oversized allocation denied before allocation");
+    ggml_ssd_cache_budget(2*1024*1024);
+    check(!ggml_ssd_reserve(3*1024*1024,GGML_SSD_CACHE),"separate expert cache byte ceiling enforced");
+    auto * cpu_dev=ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+    auto * extra=(ggml_backend_dev_get_extra_bufts_t)ggml_backend_reg_get_proc_address(ggml_backend_dev_backend_reg(cpu_dev),"ggml_backend_dev_get_extra_bufts");
+    if(extra) {
+        auto ** types=extra(cpu_dev);
+        for(int i=0;types && types[i];i++) if(std::string(ggml_backend_buft_name(types[i]))=="CPU_REPACK") {
+            ggml_ssd_scope scope(GGML_SSD_DENSE);
+            auto * b=ggml_backend_buft_alloc_buffer(types[i],1024*1024);
+            check(b!=nullptr,"repack wrapper allocates through CPU");
+            check(std::string(ggml_ssd_snapshot()).find("denseBytes\":1048576")!=std::string::npos,"nested repack allocation charged exactly once");
+            ggml_backend_buffer_free(b);
+            check(std::string(ggml_ssd_snapshot()).find("denseBytes\":0")!=std::string::npos,"nested repack release balances ledger");
+        }
+    }
+    auto * buft=ggml_backend_cpu_buffer_type();
+    {
+        ggml_ssd_scope scope(GGML_SSD_CACHE);
+        auto * b=ggml_backend_buft_alloc_buffer(buft,1024*1024);
+        check(b!=nullptr,"allowed backend allocation");
+        check(std::string(ggml_ssd_snapshot()).find("expertCacheBytes\":0")==std::string::npos,"backend charged to cache ledger");
+        ggml_backend_buffer_free(b);
+    }
+    check(std::string(ggml_ssd_snapshot()).find("expertCacheBytes\":0")!=std::string::npos,"freed backend allocation released");
+    check(!ggml_ssd_deadline(8ull*60*60*1000+1),"excessive deadline rejected");
+    ggml_ssd_stage("ready");
+    check(!ggml_ssd_deadline_armed(),"startup deadline disarmed after loading");
+    check(ggml_ssd_deadline(200),"per-request deadline arms independently of worker age");
+    check(ggml_ssd_deadline_armed(),"per-request deadline armed");
+    ggml_ssd_idle();
+    check(!ggml_ssd_deadline_armed(),"approval/idle wait has no worker lifetime deadline");
+    std::this_thread::sleep_for(std::chrono::milliseconds(350));
+    check(!ggml_ssd_stopped(),"idle wait does not consume previous request deadline");
+    ggml_ssd_finish();
+}
+static void recurrent_test() {
+    ggml_ssd_start(512ull*1024*1024,4ull*1024*1024*1024,5000);
+    auto mp=llama_model_default_params();
+    std::unique_ptr<llama_model> model(llama_model_create(LLM_ARCH_QWEN3NEXT,mp));
+    check(model!=nullptr,"synthetic recurrent metadata model");
+    auto & hp=model->hparams;
+    hp.n_layer_all=2;hp.ssm_d_conv=4;hp.ssm_d_inner=32;hp.ssm_d_state=16;hp.ssm_n_group=4;
+    hp.no_alloc=true;
+    size_t planned=0;
+    auto buffers=[](const llama_memory_recurrent & memory) {
+        std::set<ggml_backend_buffer_t> unique;
+        for(const auto * tensor:memory.r_l)if(tensor)unique.insert(tensor->buffer);
+        for(const auto * tensor:memory.s_l)if(tensor)unique.insert(tensor->buffer);
+        return unique;
+    };
+    {
+        llama_memory_recurrent memory(*model,GGML_TYPE_F32,GGML_TYPE_F32,false,2,1,0,{});
+        for(const auto & item:memory.memory_breakdown())planned+=item.second;
+        check(planned>0,"no_alloc recurrent size remains planned");
+        for(auto * buffer:buffers(memory)) {
+            check(ggml_backend_buffer_get_size(buffer)==0,"dummy recurrent buffer has zero size");
+            check(ggml_backend_buffer_get_base(buffer)==nullptr,"dummy recurrent buffer has no address");
+        }
+        for(const auto * tensor:memory.r_l)if(tensor)check(tensor->data==nullptr,"recurrent convolution data remains absent");
+        for(const auto * tensor:memory.s_l)if(tensor)check(tensor->data==nullptr,"recurrent state data remains absent");
+        memory.clear(true);
+        check(std::string(ggml_ssd_snapshot()).find("recurrentBytes\":0,")!=std::string::npos,"no recurrent allocation or zeroing in no_alloc path");
+    }
+    hp.no_alloc=false;
+    {
+        llama_memory_recurrent memory(*model,GGML_TYPE_F32,GGML_TYPE_F32,false,2,1,0,{});
+        size_t allocated=0;
+        for(auto * buffer:buffers(memory)) {
+            const auto size=ggml_backend_buffer_get_size(buffer);allocated+=size;
+            auto * bytes=static_cast<uint8_t*>(ggml_backend_buffer_get_base(buffer));
+            check(bytes && size>0,"ordinary recurrent buffer allocated");
+            for(size_t i=0;i<size;i++)check(bytes[i]==0,"ordinary recurrent payload zero initialized");
+            bytes[0]=1;memory.clear(true);check(bytes[0]==0,"ordinary recurrent clear still writes payload");
+        }
+        check(allocated==planned,"ordinary recurrent allocation preserves planned size");
+    }
+    check(std::string(ggml_ssd_snapshot()).find("recurrentBytes\":0,")!=std::string::npos,"ordinary recurrent ledger released");
+    model.reset();ggml_ssd_finish();
+}
+int main(int argc,char ** argv) {
+    try {
+        ggml_backend_load_all();
+        const std::string mode=argc>1?argv[1]:"cache";
+        if(mode=="cancel" || mode=="deadline") {
+            ggml_ssd_start(512ull*1024*1024,4ull*1024*1024*1024,mode=="deadline"?200:5000);
+            if(mode=="cancel") ggml_ssd_cancel("cancelled");
+            std::this_thread::sleep_for(std::chrono::seconds(3)); return 2;
+        }
+        if(mode=="ledger") ledger_test();
+        else if(mode=="recurrent") recurrent_test();
+        else { floors(); cache_test(mode=="metal"); }
+        printf("SSD_NATIVE_TEST %s passed %d checks\n",mode.c_str(),checks); return 0;
+    } catch(const std::exception & e) { fprintf(stderr,"SSD_NATIVE_TEST failed: %s\n",e.what()); return 1; }
+}
